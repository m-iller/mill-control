  "units": [
    {
      "name": "Футеровка",
      "description": "Барабан, износ бронеплит",
      "weight": 1.0,
      "multiplicity": null,
      "failure_modes": [
        {
          "name": "Износ футеровки",
          "description": "Утонение плит свыше минимальной толщины",
          "measurement_quantity": "толщина плиты",
          "rate_parameter": "k_l",
          "formulas": {
            "wear_rate": {
              "expression": "k_l * A * (G/G0)**a_l * (phi/phi0)**b_l * (n/n0)**c_l",
              "comment": "Степенная скорость износа футеровки, мм/ч. условное значение, требует калибровки",
              "source": "условная модель абразивного износа"
            },
            "residual": {
              "expression": "(measured - h_liner_min - consumed) if has_measurement else (R0_liner - consumed)",
              "comment": "Остаток от последнего замера либо начальный запас минус израсходованное. условное значение, требует калибровки",
              "source": "баланс ресурса"
            },
            "t_det": {
              "expression": "R / v",
              "comment": "формула по умолчанию, её можно заменить в редакторе",
              "source": "детерминированный ресурс"
            },
            "eta": {
              "expression": "t_det / gamma(1 + 1/beta_liner)",
              "comment": "масштаб Вейбулла подобран так, чтобы среднее время жизни равнялось t_det. условное значение, требует калибровки",
              "source": "распределение Вейбулла: среднее время жизни равно t_det"
            },
            "reliability": {
              "expression": "exp(-(t/eta)**beta_liner)",
              "comment": "формула по умолчанию, её можно заменить в редакторе",
              "source": "распределение Вейбулла: среднее время жизни равно t_det"
            },
            "t_fail": {
              "expression": "eta * (-log(eps))**(1/beta_liner)",
              "comment": "момент, когда P(t) падает до eps. условное значение, требует калибровки",
              "source": "распределение Вейбулла: среднее время жизни равно t_det"
            }
          }
        }
      ]
    },
